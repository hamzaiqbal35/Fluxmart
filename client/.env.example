# ==============================================================================
# Client Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local

# API Backend URLs
VITE_API_URL=http://localhost:5000/api
VITE_SERVER_URL=http://localhost:5000

# Production URLs (e.g. Render backend)
# VITE_API_URL=https://<your-render-backend>.onrender.com/api
# VITE_SERVER_URL=https://<your-render-backend>.onrender.com

# Stripe Configuration (Public / Publishable Key)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
