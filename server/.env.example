# ==============================================================================
# Server Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB Local or MongoDB Atlas Cloud)
MONGODB_URI=mongodb://localhost:27017/ecommerce
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.czvufvy.mongodb.net/fluxmart?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Client (Frontend) URL for CORS
CLIENT_URL=http://localhost:5173
# CLIENT_URL=https://your-frontend-domain.vercel.app

# Email Configuration (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM=your_email@gmail.com

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
